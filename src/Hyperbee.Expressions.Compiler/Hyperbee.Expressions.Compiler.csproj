<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Authors>Stillpoint Software, Inc.</Authors>
    <PackageId>Hyperbee.Expressions.Compiler</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>expression-tree;expressions;compiler;il;emit</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <IsPackable>true</IsPackable>
    <PackageProjectUrl>https://stillpoint-software.github.io/hyperbee.expressions.compiler/</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Stillpoint Software, Inc.</Copyright>
    <Title>Hyperbee Expressions Compiler</Title>
    <Description>High-performance IR-based expression compiler for .NET.</Description>
    <RepositoryUrl>https://github.com/Stillpoint-Software/hyperbee.expressions.compiler</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/Stillpoint-Software/hyperbee.expressions.compiler/releases/latest</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Update="$(MSBuildProjectName).csproj.DotSettings" Visible="false" />
  </ItemGroup>

  <!--
    The contracts this compiler implements: ICoroutineDelegateBuilder,
    ICoroutineMethodBuilder and IExpressionCompiler, plus the CoroutineBuilderContext
    ambient and the CoroutineClosureRewriter it runs before emitting. Coroutine nodes
    are recognized through ICoroutineBoundary rather than by their concrete types, so
    nothing here needs Hyperbee.Expressions, and this package brings no dependencies.
  -->
  <ItemGroup>
    <PackageReference Include="Hyperbee.Expressions.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>


  <!--
    Internal helpers live in this project's Internal folder and compile like any
    other source. NetstandardShims.cs is the exception: it is removed from every
    target but netstandard2.1, the way dotnet/runtime conditions its polyfills.

    hyperbee.expressions carries its own copies of ThrowIf.cs and
    NetstandardShims.cs. They are internal, so nothing crosses an assembly
    boundary and the copies cannot disagree about any contract. Sharing them through
    Hyperbee.Expressions.Abstractions was tried and rejected; the measured reason is
    recorded in that package's csproj in hyperbee.expressions.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <Compile Remove="Internal\NetstandardShims.cs" />
  </ItemGroup>

  <!--
    netstandard2.1 needs Microsoft.Bcl.AsyncInterfaces for IAsyncEnumerable.
    The compiler-required attributes and the reflection shim are hand-written in
    Internal/NetstandardShims.cs; see the note there on why not Polyfill.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <!-- Pinned to match Hyperbee.Expressions; see the note on the same group there. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" VersionOverride="8.0.0" />
  </ItemGroup>

</Project>
