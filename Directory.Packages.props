<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Development Tools -->
    <!--
      Build-time only: PolySharp is a source generator. Every project references it
      with PrivateAssets="all", so it never appears in this repository's package
      dependencies. See Directory.Build.props for what it generates and why.
    -->
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
  </ItemGroup>
  <ItemGroup>
    <!--
      The contracts this compiler implements: ICoroutineDelegateBuilder,
      ICoroutineMethodBuilder, IExpressionCompiler, ICoroutineBoundary, plus
      CoroutineBuilderContext and CoroutineClosureRewriter. This package has no
      dependencies of its own, so the compiler library takes none either.
    -->
    <PackageVersion Include="Hyperbee.Expressions.Abstractions" Version="1.7.4" />
    <!--
      The expression library itself, which owns AsyncBlockExpression and
      BlockAsync. Only the tests and benchmarks need it: they build the coroutine
      trees that the compiler is pointed at. The shipped library does not.
    -->
    <PackageVersion Include="Hyperbee.Expressions" Version="1.7.4" />
    <!-- netstandard2.1 support only; see Internal/NetstandardShims.cs and the csproj conditions. -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test and benchmark only -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FastExpressionCompiler" Version="6.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>
</Project>
